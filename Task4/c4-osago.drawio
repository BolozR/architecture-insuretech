        <mxCell id="ins" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Страховые компании × 10&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#cccccc&quot;&gt;POST /applications → внешний ID; GET /applications/{id}/offer → предложение&lt;br&gt;До 25 000 заданий при 2 500 пользователях. Пулы HTTP и квоты отдельные по компаниям.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fontFamily=Helvetica;" vertex="1" parent="1">
